.show-actions.d-flex.justify-content-between
  = link_to(controller.send(:show_back_link_location), class: "btn btn-light") do
    %i.fas.fa-chevron-left
    = t(".back")

  .btn-group
    = link_to(edit_resource_path(resource), class: "btn btn-warning text-white") do
      %i.fa-solid.fa-pencil
      = t(".edit")
    = link_to destroy_resource_path(resource),
              class: "btn btn-danger text-white",
              data: { turbo_method: :delete, turbo_confirm: t('.destroy_confirmation') } do
      %i.fa-solid.fa-fire
      = t(".destroy")