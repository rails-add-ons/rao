.index-actions.d-flex.justify-content-between
  = link_to(controller.send(:index_back_link_location), class: "btn btn-light") do
    %i.fas.fa-chevron-left
    %span.btn-text= t(".back")
  - if available_rest_actions.include?(:new)
    = link_to(new_resource_path, class: "btn btn-primary") do
      %i.fas.fa-plus
      %span.btn-text= t(".new", **inflections)
