.content-header
  .row
    .col
    %h1= resource_helper(self).label_for(@resource)

.content-body.overflow-y-auto.mb-2
  .row
    .col-12
      .before-show-table= render "before_show_table", resource: @resource

  .row
    .col
      .resource-table
        = resource_table(resource: @resource) do |table|
          = render 'show_table',         table: table
          = render 'show_table_actions', table: table

  .row
    .col
      .after-show-table= render "after_show_table", resource: @resource

.content-footer
  .row
    .col
      = render "show_actions", resource: @resource

